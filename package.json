{
  "name": "feedback-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Feedback-Hub: Enterprise Incident Bridge & Multi-Tenant Telemetry Platform",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run --prefix server dev",
    "dev:client": "npm run --prefix client dev",
    "build:server": "npm run --prefix server build",
    "build:client": "npm run --prefix client build",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
