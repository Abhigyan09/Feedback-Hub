# ==============================================================================
# FEEDBACK-HUB: ENVIRONMENT CONFIGURATION TEMPLATE
# Bank-Grade Security: Never commit production values to source control
# ==============================================================================

# 1. NODE RUNTIME
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
FRONTEND_APP_URL=http://localhost:3000

# 2. POSTGRESQL 16 DATABASE (WITH CONNECTION POOLING)
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/feedback_hub?schema=public&sslmode=disable
DB_POOL_MIN=5
DB_POOL_MAX=20

# 3. REDIS 7 (RATE LIMITING & PUB/SUB REALTIME GATEWAY)
REDIS_URL=redis://localhost:6379

# 4. AUTHENTICATION & SECRETS (GENERATE USING: openssl rand -hex 64)
JWT_ACCESS_SECRET=e7b4a2d8f9c1048b29f9e31a0b5c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e
JWT_REFRESH_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# 5. DATA ENCRYPTION AT REST (AES-256-GCM - MUST BE EXACTLY 32 BYTES / 64 HEX CHARS)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY_AES256=4f9b2d6e8a1c3e5f7a9b0c2d4e6f8a1c3e5f7a9b0c2d4e6f8a1c3e5f7a9b0c2d

# 6. INGESTION RATE LIMITING (TOKEN BUCKET)
INGEST_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX_REQUESTS=30

# 7. WEBHOOK DISPATCHING
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=3

# 8. CORS & TRUSTED ORIGINS (COMMA SEPARATED)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
